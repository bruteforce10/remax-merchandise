# Copy this file to .env.local for local development.
# Never commit .env or .env.local. Values below are placeholders only.

# ── Public variables — safe for client use ─────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WA_NUMBER=6289509046152
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key — Project settings → API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Server-only variables — NEVER expose to the client ─────────────────
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed into the admin panel (/admin/*).
# Defaults to support@remax.co.id when unset.
ADMIN_EMAILS=support@remax.co.id

# Hygraph read API — high-performance CDN endpoint (Project settings → API Access).
#   Format: https://<region>.cdn.hygraph.com/content/<projectId>/master
HYGRAPH_ENDPOINT=
# Optional read token — leave blank when the Content API is public.
HYGRAPH_TOKEN=
# Regular Content API endpoint — used for schema migrations AND content mutations.
#   Format: https://api-<region>.hygraph.com/v2/<projectId>/master
HYGRAPH_MANAGEMENT_ENDPOINT=
# Permanent Auth Token with Management API + content mutation/publish permissions.
HYGRAPH_MANAGEMENT_TOKEN=
