# Copy this file to .env.local for local development.
# Never commit .env or .env.local. Values below are placeholders only.

# ── Public variables — safe for client use ─────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WA_NUMBER=6287716289585
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key — Project settings → API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Server-only variables — NEVER expose to the client ─────────────────
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed into the admin panel (/admin/*).
# Defaults to support@remax.co.id when unset.
ADMIN_EMAILS=support@remax.co.id

# Gmail SMTP for customer order-status emails (confirmed / shipped-with-resi).
# Use a Google App Password (Account → Security → App passwords), NOT the login
# password. Leave blank to disable emails — order status still works, sending is
# skipped silently.
GMAIL_USER=support@remax.co.id
GMAIL_APP_PASSWORD=

# Hygraph read API — high-performance CDN endpoint (Project settings → API Access).
#   Format: https://<region>.cdn.hygraph.com/content/<projectId>/master
HYGRAPH_ENDPOINT=
# Optional read token — leave blank when the Content API is public.
HYGRAPH_TOKEN=
# Regular Content API endpoint — used for schema migrations AND content mutations.
#   Format: https://api-<region>.hygraph.com/v2/<projectId>/master
HYGRAPH_MANAGEMENT_ENDPOINT=
# Permanent Auth Token with Management API + content mutation/publish permissions.
HYGRAPH_MANAGEMENT_TOKEN=

# api.co.id — Indonesia Expedition Cost (ongkir) + Regional API. Server-only:
# the key is proxied through /api/regional/* and /api/shipping/* and must NEVER
# reach the browser. Leave API_CO_ID_KEY blank to disable — checkout then falls
# back to a manual-ongkir flow instead of live rates.
API_CO_ID_KEY=
API_CO_ID_BASE_URL=https://use.api.co.id
# 10-digit village (kelurahan/desa) code the store ships FROM. Look it up once via
# the Regional API (province → regency → district → village). Required for ongkir.
SHIP_ORIGIN_VILLAGE_CODE=
# Fallback per-unit weight (grams) used when a product has no weight set.
SHIP_DEFAULT_WEIGHT_GRAMS=1000
